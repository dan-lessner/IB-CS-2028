stack = []
expression = "8 7 + 2 * 6 - 32 8 / / 25 5 3 * - 14 11 - * +"
for x in expression.split():
    if x not in ["+", "-", "*", "/"]:
        stack.append(float(x))
    else:
        b = stack.pop()
        a = stack.pop()
        if x == "+":
            stack.append(a + b)
        elif x == "-":
            stack.append(a - b)
        elif x == "*":
            stack.append(a * b)
        elif x == "/":
            stack.append(a / b)
print("Postfix expression:", expression)
print("Final result:", stack[0])
